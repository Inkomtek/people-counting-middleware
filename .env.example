DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,web.internal
# Docker/production: origins allowed to POST forms (Admin login), comma separated, with scheme
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
DB_NAME=people_counting
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

ZK_CLIENT_ID=
ZK_CLIENT_SECRET=

# Real Algospection Work Order token (only used by the "work-order-real" Endpoint)
ALGOSPECTION_TOKEN=

# Token accepted by the local dummy Work Order API. Deliberately NOT the real Algospection token.
DUMMY_WO_TOKEN=dummy_local_test_token

# Public base URL shown in the API docs (temporary: dev server IP + Nginx port)
API_BASE_URL=http://192.168.10.120:8080

# Docker only: port Nginx publishes on the host (80 is taken on this machine)
NGINX_PORT=8080
