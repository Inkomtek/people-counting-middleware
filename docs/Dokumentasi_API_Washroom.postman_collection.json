              {
                "key": "X-API-Key",
                "value": "{{xApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$timestamp}}\",\n  \"inputDate\": \"{{$isoTimestamp}}\",\n  \"deviceId\": \"POSTMAN-SOAP-01\",\n  \"value\": 45,\n  \"battery\": 90,\n  \"lastOnline\": \"{{$isoTimestamp}}\",\n  \"status\": \"Hampir Habis\"\n}"
